{
  "hosting": {
    "public": "public",
    "predeploy": [
      "python update_release.py"
    ],
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/play",
        "destination": "/play.html"
      },
      {
        "source": "/play/**",
        "destination": "/play.html"
      },
      {
        "source": "/download",
        "destination": "/download.html"
      },
      {
        "source": "/downloads",
        "destination": "/download.html"
      },
      {
        "source": "/auth",
        "destination": "/auth.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
